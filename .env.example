# ============================================================
# EduGuard AI — Environment Configuration Template
# ============================================================

# ============================================================
# AWS Bedrock Configuration
# Primary LLM provider for tutoring and grading
# ============================================================

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Region (e.g., ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# ============================================================
# Bedrock Model IDs
# Pinned model versions for stability
# ============================================================

# Model for Safe Tutor (e.g., anthropic.claude-3-5-sonnet-20241022-v2:0)
TUTOR_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Model for Exam Grader
GRADER_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Model for Plagiarism Analysis (lighter model recommended)
PLAGIARISM_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ============================================================
# NVIDIA NIM Configuration (Optional)
# Alternative provider for high-performance inference
# ============================================================

# NVIDIA API Key — get from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================================
# Database Configuration
# ============================================================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017

# Database name
DB_NAME=eduguard

# ============================================================
# Supabase Authentication
# ============================================================

# Project URL and anon public key from Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local redirect URL used after Google OAuth completes.
# Add this URL in Supabase Auth > URL Configuration > Redirect URLs.
# In Google Cloud Console, add this Authorized redirect URI instead:
# https://your-project.supabase.co/auth/v1/callback
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# ============================================================
# Application Configuration
# ============================================================

# Environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Random secret key for session/security
SECRET_KEY=your_random_secret_key_here
